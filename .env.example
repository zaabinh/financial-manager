DATABASE_NAME=finance_manager_local
DATABASE_HOST_PORT=5433
DATABASE_USERNAME=replace-with-a-local-username
DATABASE_PASSWORD=replace-with-a-local-password
# Docker Compose supplies its own internal postgres URL to the backend container.
# Maven, IDEs, DBeaver, and pgAdmin connect through the published host port.
DATABASE_URL=jdbc:postgresql://localhost:5433/finance_manager_local
FLYWAY_BASELINE_DESCRIPTION=Existing db.sql schema
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=9
JWT_SECRET=replace-with-base64-encoded-32-byte-secret
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P7D
JWT_ISSUER=finance-manager-backend
JWT_AUDIENCE=finance-manager-client
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
CLIENT_PUBLIC_URL=http://localhost:8081
EMAIL_VERIFICATION_EXPIRATION=PT24H
# Configure an SMTP provider. Use an application-specific password when required.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Personal Finance Manager
MAIL_HEALTH_ENABLED=false
